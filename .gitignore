# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# build output captured for review
build.log
types.log

# مخرجات رندر الريلز.
#
# `marketing/reel/frames/` فيها ١٣٠ ألف صورة PNG - كل كادر لوحده.
# `git add -A` كان بيحاول يضيفهم كلهم فالرفع بيقف ساعات، والريبو
# بيتضخّم للأبد لأن Git بيحتفظ بكل نسخة من كل ملف.
#
# دي مخرجات، مش مصدر: الاسكريبت اللي بيولّدهم (build_frames.py)
# متحفوظ، والفيديو النهائي بيتحفظ لوحده. الكادرات نفسها بتتولّد تاني
# في أي وقت.
marketing/reel/frames/
marketing/reel/*.wav
marketing/reel/*.mp4
